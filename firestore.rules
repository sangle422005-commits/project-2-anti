rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Mỗi người dùng chỉ đọc/ghi hồ sơ của chính mình (lưu mã gia đình)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Dữ liệu gia đình: chỉ thành viên trong memberUids mới đọc/ghi được
    match /families/{familyId} {
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.memberUids;
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.memberUids;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.memberUids
        // Người có mã gia đình được tự thêm mình vào (tối đa 3 người)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
            && request.resource.data.memberUids.hasAll(resource.data.memberUids)
            && request.resource.data.memberUids.size() <= 3)
      );
    }
  }
}
